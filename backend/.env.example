DATABASE_URL=replace_with_your_neondb_connection_string

# ---------------------------------------------------------------------------
# Simulated payment gateway (demo only)
# ---------------------------------------------------------------------------
# POST /api/payments/simulate lets a customer pick a simulated outcome
# (success, failure, or cancellation) for the demo checkout. It performs NO real
# money movement and NEVER proves that funds were received.
#
# Default: disabled (unset, empty, or any value other than "true").
# When disabled, /api/payments/simulate refuses every request with 404.
# Set PAYMENT_SIMULATION_ENABLED=true ONLY in a throwaway demo/staging
# environment that must never resemble a real-payment deployment.
PAYMENT_SIMULATION_ENABLED=false

# ---------------------------------------------------------------------------
# Production deployment (Vercel frontend + separate backend host)
# ---------------------------------------------------------------------------
# NODE_ENV=production                      # Set on the backend host. Enables
#                                          # secure cookies (SameSite=None).
#
# FRONTEND_ORIGIN=https://app.vercel.app   # Required on the backend host.
#                                          # The exact Vercel frontend origin.
#                                          # Used for CORS + CSRF validation.
#                                          # Do not include a trailing slash.
#
# Frontend build-time variable (set in Vercel project settings, NOT in this file):
# VITE_API_URL=https://api.example.com     # Backend origin used by the frontend
#                                          # at build time.
